local AimTab = Window:CreateTab({name = "Aim", icon = 7743872758})

local function buildAim()
assert(Drawing and type(Drawing.new) == "function", "Drawing API is unavailable")

-- Aimbot Variables
getgenv().aimbotEnabled = false
getgenv().aimbotFov = 150
getgenv().aimbotSmoothing = 0.5
getgenv().teamCheck = false
getgenv().holdingRightClick = false
getgenv().aimbotPart = "Head"
getgenv().aimbotWallCheck = false  -- Add a wall check option

-- Manual velocity prediction; no assumptions about a game's projectile speed or lag compensation.
local predictionEnabled = false
local predictionTime = 0.10
local verticalPrediction = 1
local maxPredictionDistance = 0
local projectilePrediction = false
local projectileSpeed = 1000
local predictionState

local function finiteVector(v)
    return v.X == v.X and v.Y == v.Y and v.Z == v.Z
        and math.abs(v.X) < 1000000 and math.abs(v.Y) < 1000000 and math.abs(v.Z) < 1000000
end
-- Solve |relativePosition + velocity*t| = projectileSpeed*t for the first positive intercept.
local function interceptTime(relative, velocity, speed)
    local a = velocity:Dot(velocity) - speed * speed
    local b = 2 * relative:Dot(velocity)
    local c = relative:Dot(relative)
    if c < 0.000001 then return 0 end
    if math.abs(a) < 0.000001 then
        if math.abs(b) < 0.000001 then return nil end
        local t = -c / b
        return t > 0 and t or nil
    end
    local discriminant = b * b - 4 * a * c
    if discriminant < 0 then return nil end
    local d = math.sqrt(discriminant)
    local t1, t2 = (-b - d) / (2 * a), (-b + d) / (2 * a)
    local first = t1 > 0 and t1 or math.huge
    local second = t2 > 0 and t2 or math.huge
    local t = math.min(first, second)
    return t < math.huge and t or nil
end
local function predictedPosition(targetCharacter, targetPart, dt)
    local position = targetPart.Position
    if not predictionEnabled then predictionState = nil return position end
    local root = targetCharacter:FindFirstChild("HumanoidRootPart") or targetPart
    local rawVelocity = root.AssemblyLinearVelocity
    if not finiteVector(rawVelocity) or not finiteVector(position) then
        predictionState = nil
        return position
    end
    -- Ignore implausible samples and clear history after teleports, target changes, or long frames.
    if rawVelocity.Magnitude > 500 then predictionState = nil return position end
    local reset = not predictionState or predictionState.part ~= targetPart or dt > 0.25
    if not reset then
        local allowedTravel = math.max(10, predictionState.velocity.Magnitude * dt * 3)
        if (position - predictionState.position).Magnitude > allowedTravel then
            predictionState = nil
            return position
        end
    end
    local velocity = rawVelocity
    if not reset then
        -- Respond immediately to stops/reversals; smooth small replication fluctuations.
        if rawVelocity.Magnitude >= 0.5 and predictionState.velocity:Dot(rawVelocity) > 0 then
            velocity = predictionState.velocity:Lerp(rawVelocity, 1 - math.exp(-25 * dt))
        end
    end
    predictionState = {part = targetPart, position = position, velocity = velocity}
    local leadVelocity = Vector3.new(velocity.X, velocity.Y * verticalPrediction, velocity.Z)
    local leadTime = predictionTime
    if projectilePrediction and workspace.CurrentCamera then
        local relative = position - workspace.CurrentCamera.CFrame.Position + leadVelocity * predictionTime
        local travelTime = interceptTime(relative, leadVelocity, projectileSpeed)
        -- No possible constant-speed intercept: fall back to manual lead.
        if travelTime then leadTime = leadTime + math.min(travelTime, 5) end
    end
    local offset = leadVelocity * leadTime
    if maxPredictionDistance > 0 and offset.Magnitude > maxPredictionDistance then offset = offset.Unit * maxPredictionDistance end
    return position + offset
end

-- Initialize FOV Circle
local aimFovCircle = Drawing.new("Circle")
session.circle = aimFovCircle
aimFovCircle.Radius = getgenv().aimbotFov
aimFovCircle.Color = Color3.fromRGB(255, 0, 0)
aimFovCircle.Thickness = 2
aimFovCircle.NumSides = 100
aimFovCircle.Filled = false
aimFovCircle.Transparency = 1
aimFovCircle.Position = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
aimFovCircle.Visible = false

local function resolveTargetPart(targetCharacter)
    if getgenv().aimbotPart == "Head" then
        return targetCharacter:FindFirstChild("Head")
    end
    return targetCharacter:FindFirstChild("UpperTorso")
        or targetCharacter:FindFirstChild("Torso")
        or targetCharacter:FindFirstChild("LowerTorso")
end

local function wallCheck(startPos, endPos, targetCharacter)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local excluded = {workspace.CurrentCamera, targetCharacter}
    if player.Character then table.insert(excluded, player.Character) end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true
    return workspace:Raycast(startPos, endPos - startPos, params) ~= nil
end

-- Function to find the closest player within the FOV
local function getClosestPlayer()
    local closestPlayer, closestDistance = nil, getgenv().aimbotFov

    for _, player in pairs(game.Players:GetPlayers()) do
        if player ~= game.Players.LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local targetPart = resolveTargetPart(player.Character)

            -- Ensure the target part is valid before proceeding
            if humanoid and humanoid.Health > 0 and targetPart then
                local skip = false
                if getgenv().teamCheck and player.Team ~= nil and player.Team == game.Players.LocalPlayer.Team then
                    skip = true
                end

                if not skip then
                    local screenPoint, onScreen = workspace.CurrentCamera:WorldToViewportPoint(targetPart.Position)
                    local distanceFromCenter = (Vector2.new(screenPoint.X, screenPoint.Y) - aimFovCircle.Position).magnitude

                    if onScreen and screenPoint.Z > 0 and distanceFromCenter < closestDistance then
                        -- Wall check before considering the player as the target
                        if getgenv().aimbotWallCheck then
                            local cameraPos = workspace.CurrentCamera.CFrame.Position
                            if not wallCheck(cameraPos, targetPart.Position, player.Character) then
                                closestDistance = distanceFromCenter
                                closestPlayer = player
                            end
                        else
                            closestDistance = distanceFromCenter
                            closestPlayer = player
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

-- Render-time updates with frame-rate-independent camera smoothing.
track(RunService.RenderStepped:Connect(function(dt)
    if not session.active or Window.unloaded then return end
    local camera = workspace.CurrentCamera
    if not camera or not getgenv().aimbotEnabled or not getgenv().holdingRightClick
        or Input:GetFocusedTextBox() then predictionState = nil return end
    aimFovCircle.Position = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local target = getClosestPlayer()
    local targetCharacter = target and target.Character
    local targetPart = targetCharacter and resolveTargetPart(targetCharacter)
    if not targetPart then predictionState = nil return end
    local frameTime = math.max(dt, 0.0001)
    local targetPosition = predictedPosition(targetCharacter, targetPart, frameTime)
    local origin = camera.CFrame.Position
    -- Do not lead the aim point behind an obstruction when wall checking is enabled.
    if getgenv().aimbotWallCheck and wallCheck(origin, targetPosition, targetCharacter) then
        targetPosition = targetPart.Position
    end
    if not finiteVector(targetPosition) or (targetPosition - origin).Magnitude < 0.001 then return end
    local smoothing = math.clamp(getgenv().aimbotSmoothing, 0, 1)
    local alpha = 1 - smoothing ^ (math.min(frameTime, 0.1) * 60)
    camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(origin, targetPosition), alpha)
end))

