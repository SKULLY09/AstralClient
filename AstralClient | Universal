    if not noclipEnabled or not session.active or Window.unloaded then return end
    local current = player.Character
    for part, value in pairs(originalCollisions) do
        if not current or not part:IsDescendantOf(current) then
            pcall(function() part.CanCollide = value end); originalCollisions[part] = nil
        end
    end
