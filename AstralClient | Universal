local function stopFlight()
    if not flight then return end
    local old = flight
    flight = nil
    for _, object in ipairs(old.objects) do object:Destroy() end
    if old.root.Parent then old.root.AssemblyLinearVelocity = Vector3.zero end
    if old.humanoid.Parent then
        old.humanoid.PlatformStand = old.platformStand
        old.humanoid.AutoRotate = old.autoRotate
        if old.humanoid.Health > 0 and not old.platformStand then
            old.humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end
session.stopFlight = stopFlight
local function setFly(value)
    flyEnabled = value == true
    if not flyEnabled then stopFlight() end
end
