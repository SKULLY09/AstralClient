local hitboxEnabled, hitboxSize, hitboxTransparency = false, 25, 0.7
local hitboxColor = Color3.fromRGB(255, 0, 0)
local originals = {}
local function restoreHitbox(root, values)
    pcall(function()
        for property, value in pairs(values) do root[property] = value end
    end)
end
local function resetHitboxes()
    hitboxEnabled = false
    for root, values in pairs(originals) do restoreHitbox(root, values) end
    originals = {}
end
