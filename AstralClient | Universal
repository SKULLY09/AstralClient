    while session.active and not Window.unloaded do task.wait(0.25) end
    if session.active then session.cleanup() end
end)

-- Load only after all tabs and callbacks exist. Never overwrite a failed/missing profile automatically.
do
    local ok, loaded = pcall(function() return Window:Load(activeProfile) end)
    refreshProfiles()
    profileStatus:Set(ok and loaded and ("Loaded " .. activeProfile .. " for this game.")
        or ("No readable saved " .. activeProfile .. " config. Use Save Current Config to create it."))
end
