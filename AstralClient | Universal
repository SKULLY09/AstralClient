-- AstralClient: native Rayfield Gen2 migration (API checked against v1.2.0).
-- Gen2 configuration uses a separate filename; legacy configs are not imported.
-- Requires the same HTTP/loadstring/Drawing capabilities as the original script.
-- Static client-side key gate retained; it is not server-side authentication.
getgenv().SecureMode = true
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/gen2"))()

local previous = getgenv().__AstralSession
if previous and previous.cleanup then previous.cleanup() end
local session = {active = true, connections = {}}
getgenv().__AstralSession = session
local Window
local function track(connection)
    table.insert(session.connections, connection)
    return connection
end
function session.cleanup()
    session.active = false
    if session.destroyTeleportMarker then session.destroyTeleportMarker() end
    if session.stopNoclip then session.stopNoclip() end
    if session.stopSpectate then session.stopSpectate() end
    if session.destroyTeamHighlights then session.destroyTeamHighlights() end
    if session.resetHitboxes then session.resetHitboxes() end
    if session.stopFlight then session.stopFlight() end
    if session.stopFullbright then session.stopFullbright() end
    for _, connection in ipairs(session.connections) do connection:Disconnect() end
    session.connections = {}
    if session.esp then
        session.esp.Enabled = false
        if session.esp.Destroy then session.esp.Destroy() end
    end
    if session.circle then pcall(function() session.circle:Remove() end) end
    if Window and not Window.unloaded then Window:Unload() end
end

-- Gen2 does not expose legacy KeySystem/KeySettings. Recreate the original gate.
local KEY = "AstralKey26"
local KEY_FILE = "AstralKey_Gen2.txt"
local DISCORD = "https://discord.gg/gmUswFTXQg"
local function copyDiscord(status)
    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, DISCORD)
        if status then status:Set(ok and "Discord link copied." or DISCORD) end
    elseif status then
        status:Set(DISCORD)
    end
end
local function checkKey()
    if type(isfile) == "function" and type(readfile) == "function" then
        local ok, saved = pcall(function()
            return isfile(KEY_FILE) and readfile(KEY_FILE)
        end)
        if ok and saved == KEY then return true end
    end
    Window = Rayfield:CreateWindow({name = "AstralClient", subtitle = "Key System"})
    local keyTab = Window:CreateTab({name = "Key"})
    local status = keyTab:CreateText({name = "Enter your key", text = "Check Discord for key | " .. DISCORD})
    local accepted = false
    keyTab:CreateInput({
        name = "Key", placeholder = "Enter key and press Enter", forgetState = true,
        callback = function(value)
            if value ~= KEY then status:Set("Incorrect key. Check Discord and try again.") return end
            accepted = true
            if type(writefile) == "function" then pcall(writefile, KEY_FILE, KEY) end
        end,
    })
    keyTab:CreateButton({name = "Copy Discord invite", callback = function() copyDiscord(status) end})
    while session.active and not Window.unloaded and not accepted do task.wait(0.1) end
    local proceed = accepted and session.active and not Window.unloaded
    if not Window.unloaded then Window:Unload() end
    return proceed
end
if not checkKey() then session.cleanup() return end

