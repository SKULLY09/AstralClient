-- Fullbright snapshots lighting on enable and restores it on disable/unload.
local Lighting = game:GetService("Lighting")
local fullbright = false
local lightingBefore, effectBefore = {}, {}
local brightValues = {
    Brightness = 2, ClockTime = 14, GlobalShadows = false,
    Ambient = Color3.fromRGB(255, 255, 255),
    OutdoorAmbient = Color3.fromRGB(255, 255, 255),
    ExposureCompensation = 0, FogStart = 0, FogEnd = 1000000,
}
local function brightenEffect(object)
    local values
    if object:IsA("Atmosphere") then
        values = {Density = 0, Haze = 0, Glare = 0}
    elseif object:IsA("ColorCorrectionEffect") then
        values = {Enabled = false}
    end
    if not values then return end
    if not effectBefore[object] then
        effectBefore[object] = {}
        for property in pairs(values) do effectBefore[object][property] = object[property] end
    end
    for property, value in pairs(values) do
        if object[property] ~= value then object[property] = value end
    end
end
local function stopFullbright()
    fullbright = false
    for property, value in pairs(lightingBefore) do Lighting[property] = value end
    for object, values in pairs(effectBefore) do
        pcall(function() for property, value in pairs(values) do object[property] = value end end)
    end
    lightingBefore, effectBefore = {}, {}
end
session.stopFullbright = stopFullbright
local function applyFullbright()
    for property, value in pairs(brightValues) do
        if Lighting[property] ~= value then Lighting[property] = value end
    end
    for _, object in ipairs(Lighting:GetDescendants()) do brightenEffect(object) end
    local camera = workspace.CurrentCamera
    if camera then
        for _, object in ipairs(camera:GetDescendants()) do brightenEffect(object) end
    end
end
WorldTab:CreateToggle({
    name = "Fullbright", value = false, flag = "Fullbright",
    callback = function(value)
        if value == fullbright then return end
        if not value then stopFullbright() return end
        for property in pairs(brightValues) do lightingBefore[property] = Lighting[property] end
        fullbright = true
        applyFullbright()
    end,
})
track(RunService.RenderStepped:Connect(function()
    if session.active and not Window.unloaded and fullbright then applyFullbright() end
end))

