track(RunService.PreSimulation:Connect(function()
    if not session.active or Window.unloaded or not flyEnabled then stopFlight() return end
    local current = player.Character
    local hum = current and current:FindFirstChildOfClass("Humanoid")
    local root = current and current:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 or root.Anchored or hum.Sit then stopFlight() return end
    if flight and flight.root ~= root then stopFlight() end
    if not flight then
        local attachment = Instance.new("Attachment")
        attachment.Name = "AstralFlightAttachment"
        attachment.Parent = root
        local velocity = Instance.new("LinearVelocity")
        velocity.Name = "AstralFlightVelocity"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        velocity.ForceLimitsEnabled = false
        velocity.VectorVelocity = Vector3.zero
        velocity.Parent = root
        local orientation = Instance.new("AlignOrientation")
        orientation.Name = "AstralFlightOrientation"
        orientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        orientation.Attachment0 = attachment
        orientation.MaxTorque = math.huge
        orientation.Responsiveness = 25
        orientation.CFrame = root.CFrame.Rotation
        orientation.Parent = root
        flight = {root = root, humanoid = hum, velocity = velocity, orientation = orientation,
            platformStand = hum.PlatformStand, autoRotate = hum.AutoRotate,
            objects = {velocity, orientation, attachment}}
    end
    hum.PlatformStand = true
    hum.AutoRotate = false
    local camera = workspace.CurrentCamera
    local direction = Vector3.zero
    if camera and focused and not Input:GetFocusedTextBox() then
        local function down(key) return Input:IsKeyDown(key) and 1 or 0 end
        direction = camera.CFrame.LookVector * (down(Enum.KeyCode.W) - down(Enum.KeyCode.S))
            + camera.CFrame.RightVector * (down(Enum.KeyCode.D) - down(Enum.KeyCode.A))
            + Vector3.yAxis * (down(Enum.KeyCode.Space) - down(Enum.KeyCode.LeftControl))
    end
    if direction.Magnitude > 1 then direction = direction.Unit end
    flight.velocity.VectorVelocity = direction * flySpeed
    root.AssemblyAngularVelocity = Vector3.zero
    if camera then
        local look = camera.CFrame.LookVector
        local horizontal = Vector3.new(look.X, 0, look.Z)
        if horizontal.Magnitude > 0.001 then
            flight.orientation.CFrame = CFrame.lookAt(Vector3.zero, horizontal)
        end
    end
end))

