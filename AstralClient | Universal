local GuiService = game:GetService("GuiService")
track(RunService.RenderStepped:Connect(function()
    if not session.active or Window.unloaded or not clickTeleportEnabled or not focused
        or not controlHeld() or Input:GetFocusedTextBox() then hideTeleportMarker() return end
    local camera = workspace.CurrentCamera
    local current = player.Character
    local root = current and current:FindFirstChild("HumanoidRootPart")
    local hum = current and current:FindFirstChildOfClass("Humanoid")
    if not camera or not root or not hum or hum.Health <= 0 or hum.Sit then hideTeleportMarker() return end
    local cursor = Input:GetMouseLocation()
    local inset = GuiService:GetGuiInset()
    local ray = camera:ViewportPointToRay(cursor.X - inset.X, cursor.Y - inset.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    -- Ignore characters (including enlarged hitboxes), camera effects and our own preview.
    local excluded = {camera}
    if teleportMarker then table.insert(excluded, teleportMarker) end
    for _, other in ipairs(game:GetService("Players"):GetPlayers()) do
        if other.Character then table.insert(excluded, other.Character) end
    end
    params.FilterDescendantsInstances = excluded
    params.IgnoreWater = true
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 10000, params)
    if not hit then hideTeleportMarker() return end
    local standingHeight = hum.HipHeight + root.Size.Y / 2
    local leg = current:FindFirstChild("Left Leg") -- R6 HipHeight does not include leg length.
    if leg then standingHeight = standingHeight + leg.Size.Y end
    local position = hit.Position + Vector3.new(0, standingHeight + 0.15, 0)
    -- Add outward clearance on walls while keeping the preview upright.
    if hit.Normal.Y < 0.5 then
        position = position + hit.Normal * (math.max(root.Size.X, root.Size.Z) / 2 + 0.15)
    end
    previewDestination = CFrame.new(position) * root.CFrame.Rotation
    if not teleportMarker then
        teleportMarker = Instance.new("Part")
        teleportMarker.Name = "AstralTeleportPreview"
        teleportMarker.Shape = Enum.PartType.Ball
        teleportMarker.Size = Vector3.new(0.65, 0.65, 0.65)
        teleportMarker.Color = Color3.fromRGB(40, 255, 80)
        teleportMarker.Material = Enum.Material.Neon
        teleportMarker.Anchored = true
        teleportMarker.CanCollide = false
        teleportMarker.CanTouch = false
        teleportMarker.CanQuery = false
        teleportMarker.CastShadow = false
        teleportMarker.Transparency = 0.15
    end
    teleportMarker.CFrame = previewDestination
    teleportMarker.Parent = workspace
end))
track(Input.WindowFocusReleased:Connect(hideTeleportMarker))
track(Input.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
        if not controlHeld() then hideTeleportMarker() end
    end
end))
track(player.CharacterRemoving:Connect(hideTeleportMarker))
track(Input.InputBegan:Connect(function(input, processed)
    if processed or not session.active or Window.unloaded or not clickTeleportEnabled or not focused
        or Input:GetFocusedTextBox() or input.UserInputType ~= Enum.UserInputType.MouseButton1
        or not controlHeld() then return end
    if not previewDestination or not teleportMarker or not teleportMarker.Parent then
        clickStatus:Set("No destination. Aim at a surface while holding Ctrl.") return
    end
    -- Use precisely the last displayed destination; do not cast a different click-time ray.
    local _, message = teleportTo(previewDestination)
    clickStatus:Set(message)
    hideTeleportMarker()
end))

