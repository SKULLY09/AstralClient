        profileStatus:Set("Saved " .. activeProfile .. (remembered and " (remembered for this game)." or "; startup selection could not be saved."))
    else profileStatus:Set("Save failed. Check file API support.") end
end})
SettingsTab:CreateButton({name = "Load Selected Config", callback = function()
    if not selectedProfile then profileStatus:Set("Select a config first.") return end
    local name = selectedProfile
    local ok, loaded = pcall(function() return Window:Load(name) end)
    if ok and loaded then
        local remembered = rememberProfile(name)
        profileStatus:Set("Loaded " .. name .. (remembered and " (next startup profile)." or "; startup selection could not be saved."))
    else profileStatus:Set("Load failed; profile missing or invalid.") end
end})
SettingsTab:CreateButton({name = "Refresh Config List", callback = refreshProfiles})
SettingsTab:CreateText({name = "Config Saving", text = "Save Current Config writes changes. Save As creates and selects a new profile. The last successfully saved or loaded profile opens first for this game. Noclip, flight, teleports, spectating and hitbox activation are not restored automatically."})
